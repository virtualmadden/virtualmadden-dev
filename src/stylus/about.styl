    background-color: #f5f5f5;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto auto;
    width: 90%;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    padding: 1.5rem;
    box-shadow: 0px 4px 16px 0px rgba(0, 0, 0, 0.12);
    font-family: "Roboto", sans-serif;
    border-radius: 8px;
    gap: 1.25rem;
  }

  .thumbnail {
    grid-row: 1;
    grid-column: 1;
    width: 100%;
    height: 200px;
    box-shadow: 0px 2px 12px 0px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    border-radius: 4px;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about {
    grid-row: 2;
    grid-column: 1;
    padding: 0;
  }

  .about h1 {
    font-size: 1.3rem;
    margin: 0 0 0.25rem 0;
    color: #2c3e50;
    font-weight: 600;
  }

  .about h2 {
    font-size: 0.9rem;
    margin: 0 0 0.75rem 0;
    color: #7f8c8d;
    font-weight: 400;
  }

  .about .separator {
    margin: 0.75rem 0;
    border: none;
    border-top: 1px solid #ecf0f1;
    height: 0;
  }

  .about p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #555;
    text-align: left;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .date {
    display: none;
  }

  .social {
    grid-row: 3;
    grid-column: 1;
    padding: 0;
  }

  .social ul {
    position: static;
    margin: 0;
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .social li {
    display: inline;
    font-size: 1.2rem;
    color: #3498db;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .social li:hover {
    color: #2980b9;
  }

  .resume {
    grid-row: 4;
    grid-column: 1;
    padding: 0;
    text-align: center;
  }

  .resume i {
    background-color: #3498db;
    width: 50px;
    height: 50px;
    font-size: 1.5rem;
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 4px 14px 0px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .resume i:hover {
    background-color: #2980b9;
    box-shadow: 0px 6px 18px 0px rgba(0, 0, 0, 0.2);
    transform: translateY(-3px);
  }
}

// Tablet (768px - 1024px)
@media only screen and (min-width: bp-tablet) and (max-width: bp-desktop - 1px) {
  .card {
    background-color: #ffffff;
    display: grid;
    grid-template-columns: 40% 60%;
    grid-template-rows: 1fr auto;
    width: 85%;
    max-width: 600px;
    height: 350px;
    margin: 2rem auto;
    box-shadow: 0px 8px 24px 0px rgba(0, 0, 0, 0.12);
    font-family: "Roboto", sans-serif;
    border-radius: 8px;
    overflow: hidden;
  }

  .thumbnail {
    grid-row: 1 / span 2;
    grid-column: 1;
    width: 100%;
    height: 100%;
    box-shadow: inset 2px 0px 8px 0px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    position: relative;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about {
    grid-row: 1;
    grid-column: 2;
    padding: 1.5rem 1.5rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
  }

  .about h1 {
    font-size: 1.4rem;
    margin: 0 0 0.2rem 0;
    color: #2c3e50;
    font-weight: 600;
  }

  .about h2 {
    font-size: 0.9rem;
    margin: 0 0 0.75rem 0;
    color: #7f8c8d;
    font-weight: 400;
  }

  .about .separator {
    margin: 0.75rem 0;
    border: none;
    border-top: 1px solid #ecf0f1;
    height: 0;
  }

  .about p {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #555;
    text-align: left;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .date {
    display: none;
  }

  .social {
    grid-row: 2;
    grid-column: 2;
    padding: 0.75rem 1.5rem 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .social ul {
    position: static;
    margin: 0;
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .social li {
    display: inline;
    font-size: 1rem;
    color: #3498db;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .social li:hover {
    color: #2980b9;
  }

  .resume {
    display: none;
  }
}

// Desktop (1024px+)
@media only screen and (min-width: bp-desktop) {
  .card {
    display: grid;
    grid-template-columns: 28% 30% 18% 24%;
    grid-template-rows: 65% 35%;
    height: 19rem;
    width: 90%;
    max-width: 1100px;
    margin: 3rem auto;
    background-color: #ffffff;
    box-shadow: 0px 12px 32px 0px rgba(0, 0, 0, 0.15);
    font-family: "Roboto", sans-serif;
    border-radius: 8px;
    overflow: visible;
  }

  .thumbnail {
    grid-row: 1 / span 2;
    grid-column: 1;
    width: 100%;
    height: 100%;
    box-shadow: inset 2px 0px 8px 0px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    position: relative;
    border-radius: 8px 0 0 8px;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    border-radius: inherit;
  }

  .about {
    grid-row: 1;
    grid-column: 2 / span 3;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
  }

  .about h1 {
    font-size: 1.9rem;
    margin: 0 0 0.4rem 0;
    color: #2c3e50;
    font-weight: 600;
  }

  .about h2 {
    font-size: 1.05rem;
    margin: 0 0 1rem 0;
    color: #7f8c8d;
    font-weight: 400;
  }

  .about .separator {
    margin: 0.75rem 0;
    border: none;
    border-top: 1.5px solid #ecf0f1;
    height: 0;
  }

  .about p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    text-align: left;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .date {
    grid-row: 2;
    grid-column: 2;
    padding: 0 0 1rem 0;
    margin-left: 10px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

  h5 {
    font-size: 0.65rem;
    font-weight: 700;
    color: primary-color;
    margin: 0;
    line-height: 1
    letter-spacing: 1.5px
    text-transform: uppercase
    opacity: 0.6
  }

  h6 {
    font-size: 2.2rem;
    font-weight: 300;
    color: primary-color;
    margin: 0.4rem 0 0 0;
    line-height: 1
    letter-spacing: -0.5px
  }

  .social {
    grid-row: 2;
    grid-column: 2 / span 2;
    padding: 1.5rem 0 10px 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2rem;
  }

  .social ul {
    position: static;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }

  .social li {
    display: inline;
    font-size: 1.2rem;
    color: primary-color;
    cursor: pointer;
    transition: transition
    position: relative
    opacity: 0.8
  }

  .social li:hover {
    color: primary-hover;
    opacity: 1;
    transform: translateY(-2px);
  }

  .resume {
    grid-row: 1 / span 2;
    grid-column: 4;
    padding: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    position: relative;
  }

  .resume i {
    background: linear-gradient(135deg, primary-color, #2c7cc0);
    width: 65px;
    height: 65px;
    font-size: 1.7rem;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 8px 20px shadow-blue;
    cursor: pointer;
    transition: transition;
    margin-right: 10px;
    margin-bottom: -32px;
    z-index: 10;
  }

  .resume i:hover {
    background: linear-gradient(135deg, #2c7cc0, primary-hover);
    box-shadow: 0px 12px 28px shadow-blue-hover;
    transform: translateY(-4px);
  }
}

// Extra Wide screens (> 1280px)
@media only screen and (min-width: bp-wide) {
  .card {
    max-width: 1300px;
    height: 36rem;
  }

  .about h1 {
    font-size: 2.1rem;
  }

  .about p {
    font-size: 1rem;
    -webkit-line-clamp: 4;
  }

  h5 {
    font-size: 3.5rem;
  }

  .resume i {
    width: 75px;
    height: 75px;
    font-size: 1.9rem;
  }

  .social li {
    font-size: 1.5rem;
  }
}
