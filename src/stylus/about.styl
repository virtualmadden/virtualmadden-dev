@import url(https://fonts.googleapis.com/css?family=Roboto);

// Variables
primary-color = #3498db
primary-hover = #2980b9
text-dark = #2c3e50
text-gray = #7f8c8d
text-light = #555
bg-light = #f5f5f5
bg-white = #fff
border-light = #ecf0f1
shadow-light = rgba(0,0,0,0.1)
shadow-medium = rgba(0,0,0,0.12)
shadow-heavy = rgba(0,0,0,0.15)
shadow-blue = rgba(52,152,219,0.25)
shadow-blue-hover = rgba(52,152,219,0.35)
transition = all 0.3s ease
border-radius = 8px
border-radius-small = 4px
font-primary = "Roboto", sans-serif

// Breakpoints
bp-mobile = 28rem   // 448px
bp-phone = 45rem    // 720px
bp-tablet = 45rem   // 720px
bp-desktop = 64rem  // 1024px
bp-wide = 80rem     // 1280px

* {
  box-sizing: border-box;
}

// Mobile First - Small phones (< 448px)
@media only screen and (max-width: bp-mobile) {
  .card {
    background-color: #f5f5f5;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto auto;
    width: 95%;
    max-width: 100%;
    height: auto;
    margin: 1rem auto;
    padding: 1rem;
    box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.1);
    font-family: "Roboto", sans-serif;
    border-radius: 8px;
    gap: 1rem;
  }

  .thumbnail {
    grid-row: 1;
    grid-column: 1;
    width: 100%;
    height: 150px;
    box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, 0.15);
    overflow: hidden;
    border-radius: 4px;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about {
    grid-row: 2;
    grid-column: 1;
    padding: 0;
  }

  .about h1 {
    font-size: 1.1rem;
    margin: 0 0 0.2rem 0;
    color: #2c3e50;
    font-weight: 600;
  }

  .about h2 {
    font-size: 0.75rem;
    margin: 0 0 0.5rem 0;
    color: #7f8c8d;
    font-weight: 400;
  }

  .about .separator {
    margin: 0.5rem 0;
    border: none;
    border-top: 1px solid #ecf0f1;
    height: 0;
  }

  .about p {
    font-size: 0.75rem;
    line-height: 1.4;
    color: #555;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .date {
    display: none;
  }

  .social {
    grid-row: 3;
    grid-column: 1;
    padding: 0;
  }

  .social ul {
    position: static;
    margin: 0;
    display: flex;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .social li {
    display: inline;
    font-size: 1rem;
    color: #3498db;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .social li:hover {
    color: #2980b9;
  }

  .resume {
    grid-row: 4;
    grid-column: 1;
    padding: 0;
    text-align: center;
  }

  .resume i {
    background-color: #3498db;
    width: 45px;
    height: 45px;
    font-size: 1.3rem;
    color: white;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .resume i:hover {
    background-color: #2980b9;
    box-shadow: 0px 6px 16px 0px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }
}

