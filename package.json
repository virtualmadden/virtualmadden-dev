{
  "name": "virtualmadden-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm-run-all build:stylus --parallel build:stylus:watch start:dev",
    "start:dev": "react-scripts start",
    "build": "npm run build:stylus && react-scripts build",
    "build:stylus": "stylus src/stylus/app.styl -o src/index.css",
    "build:stylus:watch": "stylus --watch src/stylus/app.styl -o src/index.css",
    "style": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "eslint -c package.json \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint -c package.json --fix \"src/**/*.{js,jsx}\"",
    "check": "npm run style && npm run lint",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "sync:prod": "aws s3 sync build/ s3://virtualmadden.dev/ --exclude \"*.DS_Store*\"; exit_status=$?; if [ $exit_status -eq 2 ]; then exit 0; fi; exit $exit_status",
    "cache-bust:prod": "aws s3 cp build/index.html s3://virtualmadden.dev/ --cache-control max-age=0",
    "deploy:prod": "npm run sync:prod && npm run cache-bust:prod"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^8.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "style-loader": "^4.0.0",
    "stylus": "^0.64.0",
    "typescript": "^4.0.0",
    "webpack": "^5.89.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "no-console": 0,
      "import/no-namespace": 0,
      "react/display-name": 0
    },
    "env": {
      "browser": true,
      "node": true
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 12,
        "branches": 4,
        "functions": 9,
        "lines": 11
      }
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$"
    ]
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "jsxSingleQuote": true
  },
  "packageManager": "yarn@4.15.0",
  "resolutions": {
    "@tootallnate/once": "2.0.1",
    "@ungap/structured-clone": "1.3.1",
    "nth-check": "2.1.1",
    "postcss": "8.5.10",
    "qs": "6.15.2",
    "serialize-javascript": "7.0.5",
    "underscore": "1.13.8",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.4",
    "ws": "8.20.1"
  }
}
